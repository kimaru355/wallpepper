  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "isolatedModules": true, "types": ["node"]
